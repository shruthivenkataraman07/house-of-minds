[
  {
    "domain": "machine_performance",
    "output_table": "contract_machine_performance",
    "input_datasets": [
      "machine_day",
      "game_math",
      "prepared_daily_view",
      "machines"
    ],
    "grain": "machine (Jan 1 - Jun 30, 2025, active days only)",
    "required_metrics": [
      "house_win",
      "theo",
      "luck_residual",
      "luck_z",
      "hit_rate_z",
      "available_hours",
      "win_per_available_hour",
      "theo_per_available_hour"
    ],
    "filters": [
      "zone_id",
      "manufacturer",
      "config_id",
      "lease_class",
      "explanation tag"
    ],
    "validated_joins": [
      "machine_day x game_math on config_id (R08)",
      "machine_day x prepared_daily_view on (machine_id, gaming_date) (R02)"
    ],
    "limitations": [
      "Rankings describe exposure-adjusted, luck-free demand, not proof of machine quality",
      "Back Forty values include the Mar 3-Apr 6 walkway closure",
      "Bootstrap interval covers day-to-day variation only"
