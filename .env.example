# Copy to .env and fill in locally. Never commit .env.
# Authentication to Databricks uses the CLI OAuth profile; do not put tokens here.

# ---- Application ----
APP_ENV=local
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8000

# ---- Data backend: duckdb (Phase 1) | databricks (Phase 2) ----
DATA_BACKEND=duckdb
LOCAL_DB_PATH=data/processed/house_of_minds.duckdb
CHALLENGE_DATA_DIR=data/raw/dashboard-royale/data

# ---- LLM: none | openai | databricks ----
LLM_PROVIDER=none
LLM_MODEL=
# For LLM_PROVIDER=databricks use https://<host>/serving-endpoints (OpenAI-compatible)
LLM_BASE_URL=
# OPENAI_API_KEY=   # set in your shell or .env only if you choose a paid provider

# ---- Databricks ----
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_PROFILE=HOUSE_OF_MINDS
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=house_of_minds

# ---- MLflow ----
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ---- Dashboard API (backend/main.py) ----
# snapshot  = validated export in web/public/data (no credentials; labelled "Validated snapshot")
# databricks = live Unity Catalog reads (server-side auth only), per-dataset snapshot fallback
HOM_DATA_MODE=snapshot
HOM_CACHE_TTL_S=900
# Only for local `next dev` against a separate API origin, e.g. http://localhost:3000
HOM_CORS_ORIGINS=
# Live mode on a server: use a read-only service principal via standard Databricks env vars
# (DATABRICKS_HOST, DATABRICKS_CLIENT_ID, DATABRICKS_CLIENT_SECRET) set in the host's secret store.
